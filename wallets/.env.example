# Demo wallet keys. Copy to wallets/.env (gitignored) and fill in.
# The recorder reads wallets/.env, then the repo .env, then the real
# environment. Process environment wins over both files.
#
# TEST-ONLY. A key here is typed into a recording setup and its address
# appears on screen. Never use a key that holds real funds, and never commit
# wallets/.env.

# EVM: 0x + 64 hex characters.
EVM_PRIVATE_KEY=

# Solana: base58 secret key, the 64-byte keypair Phantom exports.
SOL_PRIVATE_KEY=

# Optional. Read calls (eth_call, eth_getBalance, ...) and chain id come from
# here. Without it the wallet still signs messages; it cannot read or send.
EVM_RPC_URL=

# Optional. Needed only for Solana signAndSendTransaction.
SOL_RPC_URL=

# Chain id when EVM_RPC_URL is unset. 1 = mainnet, 8453 = Base, ...
EVM_CHAIN_ID=

# Transactions are signed but NOT broadcast unless this is 1. Turn it on only
# for a demo that must send a real transaction, and only with a test key.
WALLET_BROADCAST=0
